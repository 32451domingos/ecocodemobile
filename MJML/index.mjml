<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all padding="0px"></mj-all>
      <mj-text font-family="Ubuntu, Helvetica, Arial, sans-serif" padding="0 25px" font-size="13px"></mj-text>
      <mj-section background-color="#ffffff"></mj-section>
      <mj-class name="preheader" color="#000000" font-size="11px"></mj-class>
    </mj-attributes>
    <mj-style inline="inline">a { text-decoration: none!important; color: inherit!important; }</mj-style>
  </mj-head>
  <mj-body background-color="#064113">
    <mj-section>
      <mj-column width="200px">
        <mj-image src="../assets/images/logoNome.PNG" alt="header image" padding="0px"></mj-image>
      </mj-column>
    </mj-section>
    <mj-section padding-bottom="20px" padding-top="10px">
      <mj-column>
        
        <mj-text align="center" font-size="18px" font-family="Arial">Quer fazer a diferença?<br>Dá uma nova vida ao teu telemóvel!<br /> Então venha à ESJAL dos dias 16 a 28 perto do PBX</mj-text>
        <mj-text align="center" color="#064113" font-size="25px" font-family="Arial, sans-serif" font-weight="bold" line-height="35px" padding-top="20px">Mais informações no nosso site<br/>
          <span style="font-size:18px">Clique no botão a baixo<br>↓</span></mj-text>
        <mj-button background-color="#064113" color="#FFFFFF" href="http://127.0.0.1:5500/index.html" font-family="Arial, sans-serif" padding="20px 0 0 0" font-weight="bold" font-size="16px">Saiba Mais!</mj-button>
        <mj-text align="center" color="#000000" font-size="14px" font-family="Arial, sans-serif" padding-top="40px">Domingos, <br /> © 2026 Eco Mobile. Todos os direitos reservados.
          <p></p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>